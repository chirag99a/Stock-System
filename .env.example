# App
REDIS_URL=redis://redis:6379/0
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/instant_strike
LOG_LEVEL=INFO

# Celery (broker + result backend)
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# Notification (WhatsApp/webhook)
# Set NOTIFICATION_WEBHOOK_URL to enable outgoing notifications.
NOTIFICATION_WEBHOOK_URL=
NOTIFICATION_MAX_RETRIES=5

# Reconciliation
RECONCILIATION_INTERVAL_SECONDS=60

# Premium sourcing
PREMIUM_MOCK_SCALE=1.0

# LLM
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Latency reporting (during replay)
LATENCY_REPORT_FILE=reports/latency.json

# DhanHQ WebSocket (leave empty to disable live ingestion; use /debug/replay)
DHAN_ACCESS_TOKEN=
DHAN_CLIENT_ID=
DHAN_WS_URL=wss://api-feed.dhan.co/ws
WS_RECONNECT_BASE_DELAY=1.0
WS_RECONNECT_MAX_DELAY=60.0
WS_HEALTH_STALE_SECONDS=30

# DB Pool
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
